ODOO_DB_PASSWORD=replace-with-a-strong-local-password
ODOO_HTTP_PORT=8079
# Azure Document Intelligence; keep the real key in your ignored local .env only.
# RIOCLARO_SCREENING_FUNCTION_KEY=
RIOCLARO_DOCUMENT_INTELLIGENCE_ENDPOINT=<your endpoint>
RIOCLARO_DOCUMENT_INTELLIGENCE_KEY=<your key>
RIOCLARO_TELEGRAM_BOT_TOKEN=<your token>
RIOCLARO_TELEGRAM_CHAT_ID=<your chat id>
# Azure OpenAI; keep the real API key in your ignored local .env only.
RIOCLARO_AOAI_ENDPOINT=<your endpoint>
RIOCLARO_AOAI_API_KEY=<your API key>
RIOCLARO_AOAI_DEPLOYMENT=<your deployment>
RIOCLARO_SPEECH_ENDPOINT=<your endpoint>
RIOCLARO_SPEECH_REGION=<your region>
# Azure AI Speech; keep the real key in the ignored local .env only.
RIOCLARO_SPEECH_KEY=<your key>