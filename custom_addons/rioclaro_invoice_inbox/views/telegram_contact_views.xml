<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_contact_list" model="ir.ui.view">
        <field name="name">rioclaro.telegram.contact.list</field>
        <field name="model">rioclaro.telegram.contact</field>
        <field name="arch" type="xml">
            <list string="Telegram Contacts">
                <field name="name"/>
                <field name="telegram_user_id"/>
                <field name="role"/>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_telegram_contact_form" model="ir.ui.view">
        <field name="name">rioclaro.telegram.contact.form</field>
        <field name="model">rioclaro.telegram.contact</field>
        <field name="arch" type="xml">
            <form string="Telegram Contact">
                <sheet>
                    <group>
                        <group string="Identity">
                            <field name="name"/>
                            <field name="telegram_user_id"/>
                            <field name="role"/>
                            <field name="partner_id"
                                   required="role in ('supplier', 'customer')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Permissions">
                            <field name="can_query_inventory"/>
                            <field name="can_query_purchases"/>
                            <field name="can_query_sales"/>
                            <field name="can_query_billing"/>
                            <field name="can_check_order_status"/>
                            <field name="can_request_quotation"/>
                            <field name="can_submit_vendor_invoice"/>
                            <field name="can_issue_customer_invoice"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telegram_contact" model="ir.actions.act_window">
        <field name="name">Telegram Contacts</field>
        <field name="res_model">rioclaro.telegram.contact</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_telegram_contact"
              name="Telegram Contacts"
              parent="menu_invoice_intake_root"
              action="action_telegram_contact"
              sequence="20"
              groups="base.group_system"/>
</odoo>
