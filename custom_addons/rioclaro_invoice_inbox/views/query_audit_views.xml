<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assisted_query_audit_list" model="ir.ui.view">
        <field name="name">rioclaro.assisted.query.audit.list</field>
        <field name="model">rioclaro.assisted.query.audit</field>
        <field name="arch" type="xml">
            <list string="Assisted Query Audit" create="0" edit="0" delete="0">
                <field name="request_at"/>
                <field name="telegram_user_id"/>
                <field name="contact_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="company_ids" widget="many2many_tags"/>
                <field name="input_type"/>
                <field name="tool"/>
                <field name="outcome"/>
                <field name="source_message_id"/>
            </list>
        </field>
    </record>

    <record id="action_assisted_query_audit" model="ir.actions.act_window">
        <field name="name">Assisted Query Audit</field>
        <field name="res_model">rioclaro.assisted.query.audit</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_assisted_query_audit"
              name="Assisted Query Audit"
              parent="menu_invoice_intake_root"
              action="action_assisted_query_audit"
              sequence="30"
              groups="base.group_system"/>
</odoo>
