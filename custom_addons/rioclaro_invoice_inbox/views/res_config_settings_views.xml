<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_rioclaro" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rioclaro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Río Claro Chatbot" name="rioclaro_invoice_inbox"
                     groups="base.group_system">
                    <block title="Telegram query limit">
                         <setting string="Queries per Telegram user"
                                  help="Maximum queries a Telegram user may send within the window.">
                            <field name="rioclaro_telegram_query_rate_limit"/>
                        </setting>
                        <setting string="Window (minutes)"
                                 help="Rolling window used to count queries.">
                            <field name="rioclaro_telegram_query_window_minutes"/>
                        </setting>
                    </block>
                    <block title="Telegram response style">
                        <setting string="Tone preset"
                                 help="Controls the first-contact name prompt and AI-generated Telegram answers.">
                            <field name="rioclaro_telegram_response_style"/>
                        </setting>
                        <setting string="Custom style instructions"
                                 help="Optional tone guidance for AI-generated Telegram answers; it cannot change facts or access rules.">
                            <field name="rioclaro_telegram_custom_response_style"
                                   widget="text"
                                   placeholder="For example: Use warm, concise Mexican Spanish."/>
                        </setting>
                        <setting string="Custom first-contact greeting"
                                 help="Optional replacement for the first name prompt. Leave blank to use the selected preset.">
                            <field name="rioclaro_telegram_onboarding_greeting"
                                   widget="text"
                                   placeholder="Leave blank to use the selected tone preset."/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
