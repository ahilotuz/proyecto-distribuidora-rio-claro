<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_rioclaro" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rioclaro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Río Claro Chatbot" name="rioclaro_invoice_inbox"
                     groups="base.group_system">
                    <block title="Telegram query limit">
                        <setting string="Queries per contact"
                                 help="Maximum queries a contact may send within the window.">
                            <field name="rioclaro_telegram_query_rate_limit"/>
                        </setting>
                        <setting string="Window (minutes)"
                                 help="Rolling window used to count queries.">
                            <field name="rioclaro_telegram_query_window_minutes"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
